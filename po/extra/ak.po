#: data/calendar.metainfo.xml.in:13
msgid ""
"A slim, lightweight calendar app that syncs and manages multiple calendars "
"in one place, like Google Calendar, Outlook and CalDAV."
msgstr ""
"Kalɛnda dwumadie a etumi hyehyɛ kalɛnda ahoroɔ te sɛ Google Kalɛnda, Outlook "
"ne CalDAV wɔ baabi faako."

