#: data/calendar.metainfo.xml.in:10 data/io.elementary.calendar.desktop.in:3
#: data/io.elementary.calendar.desktop.in:4
msgid "Calendar"
msgstr "კალენდარი"

#: data/calendar.metainfo.xml.in:11 data/io.elementary.calendar.desktop.in:5
msgid "View and schedule events"
msgstr "ნახეთ და დაგეგმეთ მოვლენები"

#: data/calendar.metainfo.xml.in:13
msgid ""
"A slim, lightweight calendar app that syncs and manages multiple calendars "
"in one place, like Google Calendar, Outlook and CalDAV."
msgstr ""
"თხელი, მსუბუქი კალენდრის აპი, რომელსაც ბევრი ისეთი კალენდრის ერთდროული "
"მართვა და სინქრონიზაცია შეუძლია, როგორიცაა Google Calendar, Outlook და "
"CalDAV."

#: data/calendar.metainfo.xml.in:52
msgid "elementary, Inc."
msgstr "elementary, Inc."

